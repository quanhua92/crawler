# ---- Auth ---------------------------------------------------------------
# Comma-separated list of valid API keys. Required unless CRAWLER_ALLOW_PUBLIC=true.
# Generate one with: openssl rand -hex 24
CRAWLER_API_KEYS=

# Admit anonymous (no-Bearer, no-cookie) traffic under the rate limit.
# Default false = auth required everywhere. true = public rate-limited tier enabled.
CRAWLER_ALLOW_PUBLIC=false

# Secret used to sign browser session cookies (itsdangerous URLSafeTimedSerializer).
# Leave unset to auto-generate (warns; sessions invalidate on restart).
# Generate one with: openssl rand -hex 32
CRAWLER_SESSION_SECRET=

# Browser session cookie name + lifetime (seconds). Default 7 days.
CRAWLER_SESSION_COOKIE_NAME=crawler_session
CRAWLER_SESSION_TTL=604800

# ---- Rate limits --------------------------------------------------------
# Token-bucket syntax. Anonymous tier applies only when CRAWLER_ALLOW_PUBLIC=true.
CRAWLER_PUBLIC_RATE_LIMIT=10/minute
# Authed tier: leave unset for unlimited, or set a ceiling.
# CRAWLER_AUTHED_RATE_LIMIT=

# ---- Browser tier (Tier-2) ----------------------------------------------
# Anti-detect engine for the fallback browser tier.
#   camoufox  = Firefox-based, BrowserForge fingerprint rotation (strongest vs CF)
#   patchright = undetected Chromium, drop-in Playwright API
CRAWLER_ENGINE=camoufox

# Number of warm browser contexts to keep in the pool.
CRAWLER_BROWSER_POOL_SIZE=2

# Proxy for the browser tier. Use sticky/ISP residential (NOT rotating) so
# cf_clearance cookies stay valid for their ~30min lifetime. Off by default.
# Example: http://user:pass@residential-proxy.example.com:8080
# CRAWLER_PROXY=

# Disable the browser tier entirely (Tier-1 httpx only). Saves ~300MB.
CRAWLER_BROWSER_ENABLED=true

# ---- HTTP (Tier-1) ------------------------------------------------------
CRAWLER_HTTP_TIMEOUT=30
CRAWLER_USER_AGENT=crawler/0.1 (+https://github.com/example/crawler)

# ---- Nitter instance discovery ------------------------------------------
# Cache TTL for the status.d420.de instance list, seconds.
CRAWLER_INSTANCE_CACHE_TTL=3600

# ---- SearXNG (metasearch for /search) -----------------------------------
# Internal URL. If empty, /search uses DuckDuckGo only.
CRAWLER_SEARXNG_URL=http://searxng:8080

# ---- Service ------------------------------------------------------------
# Port is controlled by docker-compose / uvicorn flags, not here.

# ---- S3 archive (RustFS / MinIO / any S3-compatible) --------------------
# When s3_endpoint is empty, archiving is disabled. Live endpoints write-through
# to S3 on every fetch; /archive/* routes read from S3 only.
CRAWLER_S3_ENDPOINT=http://rustfs:9000
CRAWLER_S3_BUCKET=crawler
CRAWLER_S3_ACCESS_KEY=rustfsadmin
CRAWLER_S3_SECRET_KEY=rustfsadmin
CRAWLER_S3_REGION=us-east-1
